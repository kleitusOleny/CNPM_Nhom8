<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Tâm Thế - Go Chess Management System</display-name>
    <description>Hệ thống quản lý cờ vây trực tuyến</description>

    <!-- Welcome files -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Servlet: Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Register -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.auth.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Forgot Password -->
    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.auth.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Lobby -->
    <servlet>
        <servlet-name>LobbyServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.game.LobbyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LobbyServlet</servlet-name>
        <url-pattern>/lobby</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Game Board -->
    <servlet>
        <servlet-name>GameServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.game.GameServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GameServlet</servlet-name>
        <url-pattern>/game/*</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Create Room -->
    <servlet>
        <servlet-name>CreateRoomServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.game.CreateRoomServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateRoomServlet</servlet-name>
        <url-pattern>/create-room</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Game History -->
    <servlet>
        <servlet-name>HistoryServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.game.HistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HistoryServlet</servlet-name>
        <url-pattern>/history</url-pattern>
    </servlet-mapping>

    <!-- Servlet: Profile -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.user.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.admin.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUsersServlet</servlet-name>
        <servlet-class>fit.hcmuaf.edu.vn.servlet.admin.AdminUsersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUsersServlet</servlet-name>
        <url-pattern>/admin/users</url-pattern>
    </servlet-mapping>


    <!-- Session config: 30 minutes -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Error pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.jsp</location>
    </error-page>

</web-app>